<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style.uss?fileID=7433441132597879392&amp;guid=2a25d9aa4030f1f42a59a0d75a5e1857&amp;type=3#Style"/>
    <ui:VisualElement name="Panel" style="flex-grow: 1; margin-left: 0%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; background-color: rgba(202, 202, 202, 0.6); flex-shrink: 0; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; width: auto;">
        <ui:VisualElement name="Question" style="flex-grow: 1; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start; flex-direction: row; flex-shrink: 0; display: none;">
            <ui:Label text="Question &#10;" name="Title" class="Title" style="font-size: 30%; flex-grow: 0; flex-shrink: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Number" class="Title" style="flex-grow: 1; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start; flex-direction: row; flex-shrink: 0; visibility: visible; display: flex;">
            <ui:Label text="01" name="CurrentQuestion" class="Title" style="font-size: 17.36px; flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="CurrentQuestion" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="/&#10;" name="Slash" style="flex-shrink: 1;"/>
            <ui:Label text="20" name="Total" class="SubTitle" style="flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="TotalQuestions" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Question" style="flex-grow: 0; justify-content: flex-start; align-items: center; align-self: stretch; align-content: flex-start; flex-direction: row; flex-shrink: 0;">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Label text="はなす" name="Kana" class="Title" style="font-size: 20%; align-self: auto; flex-grow: 0; white-space: normal; color: rgb(109, 0, 0); -unity-text-align: middle-left; flex-shrink: 1;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CurrentKana" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="はなす" name="Kanji" class="Title" style="font-size: 30%; align-self: auto; flex-grow: 1; white-space: normal; -unity-text-align: lower-left;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CurrentKanji" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Negative Standard Form" name="Question" class="Title" style="align-self: flex-start; flex-direction: column; justify-content: flex-start; flex-grow: 1; -unity-text-align: middle-left; font-size: 20%; margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; white-space: nowrap; flex-wrap: wrap; align-items: center; -unity-text-auto-size: best-fit 10px 35px; -unity-text-generator: advanced; width: 95%;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="QuestionType" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="AnswerField" class="Subtitle" style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
            <ui:TextField name="TextField" placeholder-text="Write your answer here" hide-placeholder-on-focus="true" select-all-on-mouse-up="false" select-all-on-focus="false" is-delayed="false" style="flex-grow: 1; font-size: 40%; min-height: 40px; justify-content: flex-start; align-items: stretch; flex-direction: row; align-self: center; align-content: flex-start; overflow: hidden; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; flex-shrink: 1;"/>
            <ui:Button text="Submit" name="Submit" style="font-size: 15%; align-self: center; flex-shrink: 0; flex-grow: 0;"/>
        </ui:VisualElement>
        <ui:Button name="Hint" text="Hint" class="Button" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 25%; align-items: auto; justify-content: flex-start; align-self: flex-start; -unity-font-style: normal; font-size: 15%; transition-duration: 0.25s;"/>
        <ui:Button name="Restart" text="Restart" class="Button" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 33%; align-items: center; justify-content: center; align-self: center; overflow: visible; visibility: visible; display: flex;"/>
        <ui:Label text="Correct!" display-tooltip-when-elided="true" class="Title" style="-unity-text-align: upper-center; margin-top: 5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; white-space: pre-wrap; align-self: center; -unity-text-auto-size: best-fit 10px 30px; -unity-text-generator: advanced; text-overflow: clip; flex-shrink: 1; height: 60%; flex-direction: column; width: 100%;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="PreviousAnswer" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
