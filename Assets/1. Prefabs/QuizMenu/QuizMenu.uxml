<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style.uss?fileID=7433441132597879392&amp;guid=2a25d9aa4030f1f42a59a0d75a5e1857&amp;type=3#Style"/>
    <ui:VisualElement name="Panel" style="flex-grow: 1; margin-left: 0%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; background-color: rgb(202, 202, 202); flex-shrink: 0; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;">
        <ui:VisualElement name="Number" style="flex-grow: 0; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start; flex-direction: row;">
            <ui:Label text="Question &#10;" name="Title" class="Title" style="font-size: 30%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Number" class="Title" style="flex-grow: 0; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start; flex-direction: row;">
            <ui:Label text="01" name="CurrentQuestion" class="Title" style="font-size: 17.36px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="CurrentQuestion" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="/&#10;" name="Slash"/>
            <ui:Label text="20" name="Total" class="SubTitle">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="TotalQuestions" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Question" style="flex-grow: 0; justify-content: flex-start; align-items: center; align-self: stretch; align-content: flex-start; flex-direction: row; flex-shrink: 0;">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:Label text="はなす" name="Kanji" class="Title" style="font-size: 30%; align-self: auto; flex-grow: 1; white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CurrentKanji" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="はなす" name="Kana" class="Title" style="font-size: 30%; align-self: auto; flex-grow: 1; white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CurrentKana" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Please do not overflow in this field" name="Question" class="Title" style="align-self: flex-start; flex-direction: column; justify-content: flex-start; flex-grow: 0; -unity-text-align: middle-left; font-size: 20%; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; white-space: normal; flex-wrap: wrap; align-items: center; -unity-text-auto-size: none;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="QuestionType" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="Options" class="Subtitle" style="flex-grow: 0; flex-direction: row;">
            <ui:TextField name="TextField" placeholder-text="Write your answer here" hide-placeholder-on-focus="true" select-all-on-mouse-up="false" select-all-on-focus="false" is-delayed="false" style="flex-grow: 1; font-size: 45%;"/>
        </ui:VisualElement>
        <ui:Button text="Submit" name="Submit" style="font-size: 15%;"/>
        <ui:Label text="Correct!" display-tooltip-when-elided="true" class="Title" style="-unity-text-align: upper-center; margin-top: 5%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 5%; margin-bottom: 5%; margin-left: 5%;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="PreviousAnswer" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Button name="Restart" class="Button" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 33%; align-items: center; justify-content: center; align-self: center;">
            <ui:Label text="Restart" class="Title"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
