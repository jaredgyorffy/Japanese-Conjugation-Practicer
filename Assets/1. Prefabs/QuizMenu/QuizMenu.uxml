<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style_PC.uss?fileID=7433441132597879392&amp;guid=2a25d9aa4030f1f42a59a0d75a5e1857&amp;type=3#Style_PC"/>
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style_Mobile.uss?fileID=7433441132597879392&amp;guid=805c508d13f039945a26e84fa781adcf&amp;type=3#Style_Mobile"/>
    <ui:VisualElement name="Panel" style="flex-grow: 0; margin-left: 0%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; background-color: rgba(202, 202, 202, 0.9); flex-shrink: 1; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; width: 100%; transition-property: all; transition-duration: 0.5s; transition-timing-function: ease-in-out-sine; align-self: auto; align-content: auto; justify-content: flex-start; align-items: stretch; height: 100%;">
        <ui:VisualElement name="Number" class="Title" style="flex-grow: 0; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start; flex-direction: row; flex-shrink: 1; visibility: visible; display: flex; font-size: 20%;">
            <ui:Label text="01" name="CurrentQuestion" class="Title" style="flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="CurrentQuestion" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="/&#10;" name="Slash" class="Title" style="flex-shrink: 1;"/>
            <ui:Label text="20" name="Total" class="SubTitle Title" style="flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="TotalQuestions" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Question" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/4.%20Art/Textures/UI/Dialogue/Border%20All%201.png?fileID=-1900623708&amp;guid=114c630690e13b74aacfaedbabcaa557&amp;type=3#Border All 1_44&quot;); -unity-slice-scale: 1px; -unity-slice-left: 0; height: 25%; justify-content: space-around; align-items: auto; align-self: center; align-content: auto; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; width: 100%;">
            <ui:VisualElement name="UsableSpace" style="flex-grow: 0; flex-shrink: 1; align-self: center; align-items: auto; flex-direction: column; top: auto; width: 100%; height: 100%; position: relative; justify-content: flex-start; align-content: auto; -unity-text-align: upper-left; padding-top: 13%; padding-right: 0%; padding-bottom: 0%; padding-left: 8%;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 0; align-items: auto; justify-content: flex-end; align-self: flex-start; align-content: auto; flex-direction: column; height: 75%; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; flex-wrap: nowrap; white-space: normal; width: 90%;">
                    <ui:Label text="はなす" name="Kana" class="Title" style="font-size: 20%; align-self: flex-start; flex-grow: 1; white-space: normal; color: rgb(255, 57, 57); -unity-text-align: lower-left; flex-shrink: 0; justify-content: flex-start; align-items: center; align-content: flex-start; width: 100%; height: auto; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 5px 25px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 1%; padding-right: 0%; padding-bottom: 1%; padding-left: 0%; -unity-font-style: normal;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="CurrentKana" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="はなす" name="Kanji" class="Title" style="font-size: 40%; align-self: flex-start; flex-grow: 1; white-space: normal; -unity-text-align: lower-left; flex-shrink: 0; -unity-text-auto-size: best-fit 25px 40px; -unity-text-generator: advanced; color: rgb(255, 255, 255); height: auto; width: 100%; -unity-font-style: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 1%; padding-right: 0%; padding-bottom: 1%; padding-left: 0%;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="CurrentKanji" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="Negative Standard Form Past" name="Question" class="Title" style="align-self: auto; justify-content: flex-start; -unity-text-align: middle-left; margin-top: 5%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; white-space: pre; align-items: center; width: 100%; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-text-auto-size: best-fit 10px 105px; -unity-text-generator: advanced; flex-direction: column; flex-wrap: nowrap; align-content: flex-start;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="QuestionType" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement style="height: auto; width: 100%; padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; flex-shrink: 1; margin-top: 5%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AnswerField" class="Subtitle" style="flex-grow: 0; flex-direction: row; flex-shrink: 1; align-items: flex-start; justify-content: flex-start; align-self: stretch; align-content: flex-start; height: auto; width: 100%;">
            <ui:TextField name="TextField" placeholder-text="Write your answer here" hide-placeholder-on-focus="true" select-all-on-mouse-up="false" select-all-on-focus="false" is-delayed="false" class="Subtitle" style="flex-grow: 0; min-height: 40px; justify-content: space-evenly; align-items: center; flex-direction: row; align-self: center; align-content: auto; overflow: hidden; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; flex-shrink: 1; width: 75%; -unity-text-auto-size: best-fit 10px 25px; -unity-text-generator: advanced; font-size: 23px;"/>
            <ui:Button name="Submit" text="Submit" class="Button DungeonButton" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 25%; align-items: auto; justify-content: flex-start; align-self: flex-start; transition-duration: 0.25s; align-content: flex-start; flex-direction: column; font-size: 15%; background-color: rgba(188, 188, 188, 0); padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;"/>
        </ui:VisualElement>
        <ui:Button name="Hint" text="Hint" class="Button DungeonButton" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 25%; align-items: auto; justify-content: flex-start; align-self: flex-start; transition-duration: 0.25s; align-content: flex-start; flex-direction: column; font-size: 15%; background-color: rgba(188, 188, 188, 0); padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;"/>
        <ui:Button name="Restart" text="Restart" class="Button DungeonButton" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 25%; align-items: center; justify-content: center; align-self: center; overflow: visible; visibility: visible; display: flex; font-size: 15%; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;"/>
        <ui:VisualElement style="flex-grow: 0; width: 100%; height: 25%; flex-shrink: 0; align-items: auto; justify-content: center; align-self: auto; align-content: auto;">
            <ui:Label text="Correct!" display-tooltip-when-elided="true" name="Information" class="Title" style="-unity-text-align: upper-center; margin-top: 0%; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; white-space: normal; align-self: center; -unity-text-auto-size: best-fit 10px 50px; -unity-text-generator: advanced; text-overflow: clip; flex-shrink: 0; height: 100%; flex-direction: column; width: 100%; color: rgb(255, 255, 255); -unity-text-outline-width: 0; background-image: url(&quot;project://database/Assets/4.%20Art/Textures/UI/Dialogue/Border%20All%201.png?fileID=855616256&amp;guid=114c630690e13b74aacfaedbabcaa557&amp;type=3#Border All 1_71&quot;); -unity-slice-scale: 1px; flex-grow: 0;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="PreviousAnswer" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
