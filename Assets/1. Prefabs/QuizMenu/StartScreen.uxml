<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style.uss?fileID=7433441132597879392&amp;guid=2a25d9aa4030f1f42a59a0d75a5e1857&amp;type=3#Style"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(255, 255, 255); padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%;">
        <ui:VisualElement name="Options" style="flex-grow: 0; flex-direction: row;">
            <ui:VisualElement name="VerbForms" style="flex-grow: 0; flex-direction: column; flex-wrap: nowrap; flex-shrink: 1; width: 50%;">
                <ui:Label text="Verb Forms&#10;" name="VerbFormsTitle" class="Title"/>
            </ui:VisualElement>
            <ui:VisualElement name="AdjectiveForms" style="flex-grow: 0; flex-direction: column; flex-wrap: nowrap; flex-shrink: 1; width: 50%;">
                <ui:Label text="Adjective Forms&#10;" name="AdjectiveFormsTitle" class="Title"/>
            </ui:VisualElement>
            <ui:VisualElement name="Spacer" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; width: 0%;"/>
            <ui:VisualElement name="Content" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; width: 50%;">
                <ui:Label text="Content" name="ContentTitle" class="Title"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:IntegerField label="Number of Questions" value="12" name="QuestionCount" style="width: 33%; align-self: center;"/>
        <ui:Button name="Start" class="Button" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 33%; align-items: center; justify-content: center; align-self: center;">
            <ui:Label text="Begin Quiz" class="Title"/>
        </ui:Button>
        <ui:Label text="Label" name="Warning" class="Title" style="align-self: center; color: rgb(255, 0, 0); visibility: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
